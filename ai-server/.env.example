# Recall AI Server — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ── Ollama ──────────────────────────────────────────────────────────────────
# Where Ollama is listening. For local development this is always localhost.
# The AI server communicates with Ollama locally — never expose Ollama directly
# to the mobile device.
OLLAMA_BASE_URL=http://localhost:11434

# ── Model names (must match exactly what is shown in `ollama list`) ─────────
QWEN_TEXT_MODEL=qwen3:8b
QWEN_VISION_MODEL=qwen2.5vl:3b
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ── Server ───────────────────────────────────────────────────────────────────
AI_SERVER_PORT=8000

# Bind address for the AI server.
# Use 0.0.0.0 so a physical Android device on the same Wi-Fi can reach it.
# Use 127.0.0.1 if you only need web/simulator access.
AI_SERVER_HOST=0.0.0.0

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
# Vision requests take longer than text requests.
AI_REQUEST_TIMEOUT=120
AI_VISION_TIMEOUT=180

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser-based clients (Expo web).
# Do NOT use * in production. For local development the Expo dev server origin
# is http://localhost:8081 (Metro) or http://localhost:19006 (older Expo web).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Set to DEBUG for verbose output during hackathon development.
LOG_LEVEL=INFO
